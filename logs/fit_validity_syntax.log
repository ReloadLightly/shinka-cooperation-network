                  mat <- sna::symmetrize(mat, rule = "weak")
                if (v == NET_DV) 
                  data[[v]][, , k] <- mat
                else if (v %in% DYADIC) 
                  data[[paste0("d.", v)]][, , k] <- mat
                else contig <- mat
            }
            mono <- unique(d[c("ccode1", BEH_DV, setdiff(MONADIC, 
                "milexSpLag_1"))])
            if (anyDuplicated(mono$ccode1)) 
                stop("Inconsistent monadic values within country-year")
            mi <- match(mono$ccode1, nms)
            rawbeh <- rep(NA_real_, N)
            rawbeh[mi] <- mono[[BEH_DV]]
            data[[paste0(BEH_DV, ".orig")]][, k] <- rawbeh
            data[[BEH_DV]][, k] <- as.numeric(cut(rawbeh, c(seq(0, 
                0.1, 0.01), 1), labels = 1:11, right = FALSE))
            for (v in setdiff(MONADIC, "milexSpLag_1")) data[[paste0("m.", 
                v)]][mi, k] <- mono[[v]]
            active <- which(present[, k])
            w <- contig[active, active, drop = FALSE]
            w <- w/rowSums(w)
            w[is.nan(w)] <- 0
            z <- rawbeh[active]
