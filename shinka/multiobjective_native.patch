+            "next_generation_to_submit": self.next_generation_to_submit,
+            "completed_generations": self.completed_generations,
+            "prompt_evolution_counter": self.prompt_evolution_counter,
+            "prompt_api_cost": self.prompt_api_cost, "total_api_cost": self.total_api_cost,
+            "avg_proposal_cost": self.avg_proposal_cost,
+            "completed_proposal_costs": self.completed_proposal_costs,
+            "pending_evaluations": self._project_pending_count(),
+            "deadline": self._project_window_deadline, "saved_at": time.time()}
+        if self.meta_summarizer:
+            self.meta_summarizer.save_meta_state(str(Path(self.results_dir) / "project_meta_state.json"))
+        self.db._update_metadata_in_db("project_execution_window", json.dumps(state, allow_nan=False))
