+            self.next_generation_to_submit = max(self.next_generation_to_submit, state["next_generation_to_submit"])
+            self.prompt_evolution_counter = state.get("prompt_evolution_counter", 0)
+            self.prompt_api_cost = state.get("prompt_api_cost", 0.0)
+            self.total_api_cost = max(self.total_api_cost, state.get("total_api_cost", 0.0))
