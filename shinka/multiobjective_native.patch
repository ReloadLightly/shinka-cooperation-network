+    def request_pause(self, reason="paused_execution_window") -> None:
+        """Stop new proposals/evaluations; active evaluator checkpoints between R jobs."""
+        self.project_pause_requested = True
+        self.project_pause_reason = reason
+        self.slot_available.set()
+
+    def _project_prepare_window(self) -> None:
+        deadlines = []
+        seconds = self.evo_config.execution_window_seconds
+        if seconds is not None:
+            if isinstance(seconds, bool) or not math.isfinite(seconds) or seconds <= 0:
+                raise ValueError("execution_window_seconds must be positive and finite")
+            deadlines.append(time.time() + seconds)
+        absolute = os.environ.get("SHINKA_EXECUTION_DEADLINE")
+        if absolute:
+            deadline = float(absolute)
+            if not math.isfinite(deadline):
+                raise ValueError("SHINKA_EXECUTION_DEADLINE must be finite Unix seconds")
+            deadlines.append(deadline)
+        self._project_window_managed = bool(deadlines)
+        if deadlines:
+            self._project_window_deadline = min(deadlines)
+            os.environ["SHINKA_EXECUTION_DEADLINE"] = str(self._project_window_deadline)
+            self._project_window_timer = asyncio.get_running_loop().call_later(
+                max(0.0, self._project_window_deadline - time.time()), self.request_pause)
+
+    def _project_window_closed(self) -> bool:
+        if self._project_window_deadline is not None and time.time() >= self._project_window_deadline:
+            self.request_pause()
+        return self.project_pause_requested
