+    def kill(self):
+        """Stop owned descendants, including evaluator children in new sessions.
+
+        Project compatibility patch: native Popen.kill only stops the evaluator
+        parent, leaving detached R process groups alive. Snapshot descendants
+        before signaling so reparenting cannot hide them from cleanup.
+        """
+        import psutil
+
+        if self.process.poll() is not None:
+            return
+        try:
+            descendants = psutil.Process(self.process.pid).children(recursive=True)
+        except psutil.NoSuchProcess:
+            return
+        for child in reversed(descendants):
+            try:
+                child.terminate()
+            except psutil.NoSuchProcess:
+                pass
+        _, alive = psutil.wait_procs(descendants, timeout=10)
+        for child in alive:
+            try:
+                child.kill()
+            except psutil.NoSuchProcess:
+                pass
+        # Give the trusted evaluator a chance to write its invalidity diagnostics.
+        try:
+            self.process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            self.process.kill()
+            self.process.wait(timeout=10)
+
